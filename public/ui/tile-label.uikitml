<!--
  Label on the front of a puzzle tile. src/visual-puzzle.ts sets tile-text
  to the tile's object name from content/puzzles.json; "..." is only a
  placeholder. Plain divs keep these colors in both color schemes.
-->
<style>
  .label {
    width: 120px;
    height: 70px;
    align-items: center;
    justify-content: center;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 10px;
    background-color: #f1ece3;
  }

  .text {
    color: #1d1e22;
    font-size: 16px;
    font-weight: 700;
    text-align: center;
    line-height: 1.15;
  }
</style>
<div class="label">
  <span id="tile-text" class="text">...</span>
</div>
