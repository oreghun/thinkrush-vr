<!--
  The puzzle panel above the table. Ids that are message keys get their text
  from src/i18n via src/ui-text.ts; src/puzzle.ts fills the others (prompt,
  question, score, timer, status, detail and the button labels), colors the
  timer and status for each state, and shows the buttons that fit the mode:
  practice offers Start run and Next puzzle, a run offers Skip, and the
  run-over summary offers Run again and Back to practice. "..." is only a
  placeholder.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 440px;
  }

  .panel-content {
    flex-direction: column;
    gap: 8px;
    padding: 22px;
  }

  .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .eyebrow {
    color: #6b5a00;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .eyebrow:dark {
    color: #f5d90a;
  }

  .timer {
    font-size: 26px;
    font-weight: 700;
  }

  .prompt {
    color: #1c1d20;
    font-size: 23px;
    font-weight: 700;
    line-height: 1.3;
  }

  .prompt:dark {
    color: #fafaf7;
  }

  .question {
    color: #6b5a00;
    font-size: 21px;
    font-weight: 700;
    line-height: 1.3;
  }

  .question:dark {
    color: #f5d90a;
  }

  .status {
    font-size: 21px;
    font-weight: 700;
    line-height: 1.3;
  }

  .detail {
    color: #3a3b40;
    font-size: 19px;
    line-height: 1.35;
  }

  .detail:dark {
    color: #dddfe3;
  }

  .button {
    justify-content: flex-start;
    margin-left: 22px;
    margin-right: 22px;
    margin-bottom: 22px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="header">
      <span id="puzzle.eyebrow" class="eyebrow">...</span>
      <span id="puzzle-score" class="timer" style="display: none">...</span>
      <span id="puzzle-timer" class="timer">...</span>
    </div>
    <div id="puzzle-prompt" class="prompt">...</div>
    <div id="puzzle-question" class="question" style="display: none">...</div>
    <div id="puzzle-status" class="status">...</div>
    <div id="puzzle-detail" class="detail">...</div>
  </div>
  <Button id="puzzle-run" class="button">
    <ButtonIcon>
      <Play></Play>
    </ButtonIcon>
    <ButtonLabel id="puzzle-run-label" class="button-label">...</ButtonLabel>
  </Button>
  <Button id="puzzle-restart" class="button">
    <ButtonIcon>
      <ArrowRight></ArrowRight>
    </ButtonIcon>
    <ButtonLabel id="puzzle-next-label" class="button-label">...</ButtonLabel>
  </Button>
  <Button id="puzzle-exit" class="button" style="display: none">
    <ButtonIcon>
      <RotateCcw></RotateCcw>
    </ButtonIcon>
    <ButtonLabel id="puzzle-exit-label" class="button-label">...</ButtonLabel>
  </Button>
</Panel>
