<!--
  Panel, Button, ButtonIcon, and ButtonLabel come from the bundled Horizon kit.
  RectangleGoggles, LogIn and Languages are bundled Lucide icon components.
  The :dark styles apply because iwsdk.config.json prefers the dark color
  scheme. Ids that are message keys get their text from src/i18n via
  src/ui-text.ts; "..." is only a placeholder.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 420px;
  }

  .panel-content {
    flex-direction: column;
    gap: 7px;
    padding: 22px;
  }

  .eyebrow {
    color: #6b5a00;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .eyebrow:dark {
    color: #f5d90a;
  }

  .heading {
    color: #1c1d20;
    font-size: 30px;
    font-weight: 700;
    line-height: 36px;
  }

  .heading:dark {
    color: #fafaf7;
  }

  .body {
    color: #3a3b40;
    font-size: 20px;
    line-height: 27px;
  }

  .body:dark {
    color: #dddfe3;
  }

  .button {
    justify-content: flex-start;
    margin-left: 22px;
    margin-right: 22px;
    margin-bottom: 22px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div id="welcome.eyebrow" class="eyebrow">...</div>
    <div id="welcome.heading" class="heading">...</div>
    <div id="welcome.body1" class="body">...</div>
    <div id="welcome.body2" class="body">...</div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel id="welcome.enterVR" class="button-label">...</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel id="welcome.exitVR" class="button-label">...</ButtonLabel>
  </Button>
  <Button id="language-button" class="button">
    <ButtonIcon>
      <Languages></Languages>
    </ButtonIcon>
    <ButtonLabel id="language-label" class="button-label">...</ButtonLabel>
  </Button>
</Panel>
